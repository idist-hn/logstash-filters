{
  "index_patterns": ["metrics-allow-*"],
  "data_stream": {},
  "priority": 200,
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 1,
        "number_of_replicas": 0,
        "refresh_interval": "5s",
        "codec": "best_compression",
        "lifecycle": {
          "name": "allow-policy"
        }
      }
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "agent": {
          "properties": {
            "type": { "type": "keyword" },
            "version": { "type": "keyword" },
            "name": { "type": "keyword" }
          }
        },
        "service": {
          "properties": {
            "type": { "type": "keyword" },
            "name": { "type": "keyword" }
          }
        },
        "metricset": {
          "properties": {
            "name": { "type": "keyword" }
          }
        },
        "host": {
          "properties": {
            "name": { "type": "keyword" },
            "ip": { "type": "ip" }
          }
        },
        "mysql": {
          "properties": {
            "status": {
              "properties": {
                "connections": { "type": "long" },
                "max_connections": { "type": "long" },
                "threads_connected": { "type": "long" },
                "threads_running": { "type": "long" },
                "queries": { "type": "long" },
                "slow_queries": { "type": "long" },
                "com_select": { "type": "long" },
                "com_insert": { "type": "long" },
                "com_update": { "type": "long" },
                "com_delete": { "type": "long" }
              }
            },
            "performance": {
              "properties": {
                "events_statements_total": { "type": "long" },
                "events_statements_current": { "type": "long" }
              }
            }
          }
        },
        "postgresql": {
          "properties": {
            "database": {
              "properties": {
                "name": { "type": "keyword" },
                "number_of_backends": { "type": "long" },
                "transactions": {
                  "properties": {
                    "commit": { "type": "long" },
                    "rollback": { "type": "long" }
                  }
                },
                "blocks": {
                  "properties": {
                    "read": { "type": "long" },
                    "hit": { "type": "long" }
                  }
                },
                "rows": {
                  "properties": {
                    "returned": { "type": "long" },
                    "fetched": { "type": "long" },
                    "inserted": { "type": "long" },
                    "updated": { "type": "long" },
                    "deleted": { "type": "long" }
                  }
                }
              }
            }
          }
        },
        "elasticsearch": {
          "properties": {
            "node": {
              "properties": {
                "name": { "type": "keyword" },
                "jvm": {
                  "properties": {
                    "memory": {
                      "properties": {
                        "heap": {
                          "properties": {
                            "used": { "type": "long" },
                            "max": { "type": "long" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "system": {
          "properties": {
            "cpu": {
              "properties": {
                "total": {
                  "properties": {
                    "pct": { "type": "float" }
                  }
                },
                "user": {
                  "properties": {
                    "pct": { "type": "float" }
                  }
                },
                "system": {
                  "properties": {
                    "pct": { "type": "float" }
                  }
                },
                "idle": {
                  "properties": {
                    "pct": { "type": "float" }
                  }
                },
                "iowait": {
                  "properties": {
                    "pct": { "type": "float" }
                  }
                },
                "cores": { "type": "long" }
              }
            },
            "memory": {
              "properties": {
                "total": { "type": "long" },
                "used": {
                  "properties": {
                    "bytes": { "type": "long" },
                    "pct": { "type": "float" }
                  }
                },
                "free": { "type": "long" },
                "available": { "type": "long" },
                "cached": { "type": "long" },
                "swap": {
                  "properties": {
                    "total": { "type": "long" },
                    "used": {
                      "properties": {
                        "bytes": { "type": "long" },
                        "pct": { "type": "float" }
                      }
                    },
                    "free": { "type": "long" }
                  }
                }
              }
            },
            "load": {
              "properties": {
                "1": { "type": "float" },
                "5": { "type": "float" },
                "15": { "type": "float" },
                "cores": { "type": "long" }
              }
            },
            "diskio": {
              "properties": {
                "read": {
                  "properties": {
                    "bytes": { "type": "long" },
                    "count": { "type": "long" },
                    "time": { "type": "long" }
                  }
                },
                "write": {
                  "properties": {
                    "bytes": { "type": "long" },
                    "count": { "type": "long" },
                    "time": { "type": "long" }
                  }
                },
                "io": {
                  "properties": {
                    "time": { "type": "long" }
                  }
                }
              }
            },
            "filesystem": {
              "properties": {
                "total": { "type": "long" },
                "used": {
                  "properties": {
                    "bytes": { "type": "long" },
                    "pct": { "type": "float" }
                  }
                },
                "free": { "type": "long" },
                "available": { "type": "long" },
                "files": { "type": "long" },
                "free_files": { "type": "long" }
              }
            },
            "network": {
              "properties": {
                "in": {
                  "properties": {
                    "bytes": { "type": "long" },
                    "packets": { "type": "long" },
                    "errors": { "type": "long" },
                    "dropped": { "type": "long" }
                  }
                },
                "out": {
                  "properties": {
                    "bytes": { "type": "long" },
                    "packets": { "type": "long" },
                    "errors": { "type": "long" },
                    "dropped": { "type": "long" }
                  }
                }
              }
            },
            "process": {
              "properties": {
                "cpu": {
                  "properties": {
                    "total": {
                      "properties": {
                        "pct": { "type": "float" }
                      }
                    }
                  }
                },
                "memory": {
                  "properties": {
                    "size": { "type": "long" },
                    "rss": {
                      "properties": {
                        "bytes": { "type": "long" },
                        "pct": { "type": "float" }
                      }
                    }
                  }
                },
                "state": { "type": "keyword" },
                "num_threads": { "type": "long" },
                "summary": {
                  "properties": {
                    "total": { "type": "long" },
                    "running": { "type": "long" },
                    "sleeping": { "type": "long" },
                    "stopped": { "type": "long" },
                    "zombie": { "type": "long" },
                    "idle": { "type": "long" }
                  }
                }
              }
            },
            "socket": {
              "properties": {
                "summary": {
                  "properties": {
                    "tcp": {
                      "properties": {
                        "all": {
                          "properties": {
                            "count": { "type": "long" }
                          }
                        },
                        "listening": { "type": "long" },
                        "established": { "type": "long" }
                      }
                    },
                    "udp": {
                      "properties": {
                        "all": {
                          "properties": {
                            "count": { "type": "long" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "uptime": {
              "properties": {
                "duration": {
                  "properties": {
                    "ms": { "type": "long" }
                  }
                }
              }
            }
          }
        },
        "filter_status": { "type": "keyword" },
        "filter_processed_at": { "type": "date" },
        "removed_fields": { "type": "keyword" },
        "processed_by": { "type": "keyword" },
        "pipeline": { "type": "keyword" },
        "tags": { "type": "keyword" }
      }
    }
  }
}
