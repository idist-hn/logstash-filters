# Metricbeat Pipeline with Database Filtering
# Pipeline chuyên dụng cho Metricbeat với filter rules cho MySQL và PostgreSQL

input {
  # Beats input for Metricbeat
  beats {
    port => 5044
    host => "0.0.0.0"
  }
}

filter {
  # Only process Metricbeat events
  if [agent][type] != "metricbeat" {
    drop { }
  }
  
  # Load filter rules from file
  ruby {
    init => "
      require 'yaml'
      @@filter_rules = YAML.load_file('/usr/share/logstash/config-custom/database-filter-rules.yml')
      @@blocked_count = 0
      @@allowed_count = 0
    "
    code => "
      rules = @@filter_rules
      event_data = event.to_hash
      
      # Check if filtering is enabled globally
      if !rules['global']['enabled']
        event.set('filter_status', 'bypassed')
        next
      end
      
      # Get metricset info
      service_type = event.get('[service][type]')
      metricset_name = event.get('[metricset][name]')
      
      # Initialize filter result
      should_block = false
      block_reasons = []
      
      # MySQL filtering
      if service_type == 'mysql' && rules['mysql']['enabled']
        mysql_rules = rules['mysql']
        
        # Check allowed/blocked metricsets
        if mysql_rules['blocked_metricsets'].include?(metricset_name)
          should_block = true
          block_reasons << 'blocked_metricset'
        elsif !mysql_rules['allowed_metricsets'].empty? && !mysql_rules['allowed_metricsets'].include?(metricset_name)
          should_block = true
          block_reasons << 'metricset_not_allowed'
        end
        
        # Check required fields
        mysql_rules['required_fields'].each do |field|
          if !event.get(field)
            should_block = true
            block_reasons << 'missing_required_field:' + field
          end
        end
        
        # Check blocked fields
        mysql_rules['field_filters']['blocked_fields'].each do |pattern|
          if pattern.include?('*')
            # Wildcard pattern
            regex_pattern = pattern.gsub('*', '.*')
            event_data.each do |key, value|
              if key.match(/#{regex_pattern}/)
                event.remove(key)
                event.set('removed_fields', (event.get('removed_fields') || []) + [key])
              end
            end
          else
            # Exact field name
            if event.get(pattern)
              event.remove(pattern)
              event.set('removed_fields', (event.get('removed_fields') || []) + [pattern])
            end
          end
        end
        
        # Check value limits for connections
        if metricset_name == 'status'
          connections = event.get('[mysql][status][threads_connected]')
          if connections && mysql_rules['value_limits']['connections']
            min_conn = mysql_rules['value_limits']['connections']['min']
            max_conn = mysql_rules['value_limits']['connections']['max']
            if connections < min_conn || connections > max_conn
              should_block = true
              block_reasons << 'connection_limit_exceeded'
            end
          end
        end
      end
      
      # PostgreSQL filtering
      if service_type == 'postgresql' && rules['postgresql']['enabled']
        pg_rules = rules['postgresql']
        
        # Check allowed/blocked metricsets
        if pg_rules['blocked_metricsets'].include?(metricset_name)
          should_block = true
          block_reasons << 'blocked_metricset'
        elsif !pg_rules['allowed_metricsets'].empty? && !pg_rules['allowed_metricsets'].include?(metricset_name)
          should_block = true
          block_reasons << 'metricset_not_allowed'
        end
        
        # Check required fields
        pg_rules['required_fields'].each do |field|
          if !event.get(field)
            should_block = true
            block_reasons << 'missing_required_field:' + field
          end
        end
        
        # Check blocked fields
        pg_rules['field_filters']['blocked_fields'].each do |pattern|
          if pattern.include?('*')
            # Wildcard pattern
            regex_pattern = pattern.gsub('*', '.*')
            event_data.each do |key, value|
              if key.match(/#{regex_pattern}/)
                event.remove(key)
                event.set('removed_fields', (event.get('removed_fields') || []) + [key])
              end
            end
          else
            # Exact field name
            if event.get(pattern)
              event.remove(pattern)
              event.set('removed_fields', (event.get('removed_fields') || []) + [pattern])
            end
          end
        end
        
        # Block query field if it contains sensitive data
        query = event.get('[postgresql][activity][query]')
        if query && rules['content_filters']['enabled']
          rules['content_filters']['sensitive_patterns'].each do |pattern|
            if query.match(/#{pattern}/)
              event.remove('[postgresql][activity][query]')
              event.set('removed_fields', (event.get('removed_fields') || []) + ['postgresql.activity.query'])
              event.set('query_blocked_reason', 'sensitive_content')
              break
            end
          end
        end
      end
      
      # Apply decision
      if should_block
        event.set('filter_status', 'blocked')
        event.set('block_reasons', block_reasons)
        event.tag('_filtered_blocked')
        @@blocked_count += 1
        
        # Log blocked event if enabled
        if rules['global']['log_filtered_events']
          logger.warn('Blocked metricbeat event', :reasons => block_reasons, :service => service_type, :metricset => metricset_name)
        end
      else
        event.set('filter_status', 'allowed')
        event.tag('_filtered_allowed')
        @@allowed_count += 1
      end
      
      # Add processing metadata
      event.set('filter_processed_at', Time.now.utc.iso8601)
      event.set('filter_stats', {
        'blocked_count' => @@blocked_count,
        'allowed_count' => @@allowed_count
      })
    "
  }
  
  # Drop blocked events
  if "blocked" in [filter_status] {
    drop { }
  }
  
  # Add additional metadata for allowed events
  if "allowed" in [filter_status] {
    mutate {
      add_field => { "processed_by" => "logstash_filtered" }
      add_field => { "pipeline" => "metricbeat-filtered" }
    }
  }
  
  # Parse timestamp if needed
  if [event][created] {
    date {
      match => [ "[event][created]", "ISO8601" ]
      target => "@timestamp"
    }
  }
}

output {
  # Send allowed events to Elasticsearch
  if "allowed" in [filter_status] {
    elasticsearch {
      hosts => ["elasticsearch:9200"]
      user => "${ELASTIC_USERNAME:elastic}"
      password => "${ELASTIC_PASSWORD:changeme123}"
      index => "metricbeat-filtered-%{+YYYY.MM.dd}"
      action => "create"
    }
  }
  
  # Debug output for development
  if [filter_status] == "allowed" {
    stdout {
      codec => rubydebug {
        metadata => false
      }
    }
  }
  
  # Send filter statistics to separate index
  if [filter_stats] {
    elasticsearch {
      hosts => ["elasticsearch:9200"]
      user => "${ELASTIC_USERNAME:elastic}"
      password => "${ELASTIC_PASSWORD:changeme123}"
      index => "metricbeat-filter-stats-%{+YYYY.MM.dd}"
      action => "create"
      document_id => "%{[host][name]}-%{[service][type]}-%{+HH}"
    }
  }
}
