KIBANA_PASSWORD=changeme123
STACK_VERSION=8.11.0

# Elasticsearch
ES_PORT=9200
ES_HOST=elasticsearch
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Kibana
KIBANA_PORT=5601

# Logstash
LOGSTASH_PORT=5044

# Backend API
API_PORT=8081
API_HOST=0.0.0.0
