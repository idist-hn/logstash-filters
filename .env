# Application Configuration
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme123
KIBANA_URL=http://localhost:5601
KIBANA_USERNAME=elastic
KIBANA_TIMEOUT=30
LOG_LEVEL=info
CACHE_ENABLED=true
CACHE_TTL=5m

# Frontend
FRONTEND_PORT=3000

# Database
DB_HOST=localhost
DB_PORT=9200
